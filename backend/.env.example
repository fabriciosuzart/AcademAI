# Copie este arquivo para backend/.env (ignorado pelo git) e preencha.
# Sem SMTP_HOST, os e-mails (senha temporária, notificações) só aparecem no console.
#
# Exemplo com Gmail: ative a verificação em duas etapas na conta e gere uma
# "senha de app" em https://myaccount.google.com/apppasswords (use ela em SMTP_PASS,
# não a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu.email@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
SMTP_FROM=AcademAI <seu.email@gmail.com>
